{
  "name": "@starter/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "db:generate": "bunx --bun prisma generate",
    "db:validate": "bunx --bun prisma validate",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:format": "bunx --bun prisma format",
    "typecheck": "tsc --noEmit",
    "build": "bun run db:generate && tsc --noEmit",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "typescript": "^5.9.3"
  }
}
