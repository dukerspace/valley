# Copy to `.env` at the repo root and adjust values as needed.
# All apps and packages load this single root env file.

# --- PostgreSQL (Prisma) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/valley?schema=public"

# --- Auth ---
# Use a long random string in production (min 16 chars).
JWT_SECRET="dev-only-change-me-jwt-secret"

# --- API (Hono / Bun) ---
API_HOST="127.0.0.1"
API_PORT="3001"
API_URL="http://127.0.0.1:3001"

# --- Frontend (TanStack Start / Vite) ---
FRONTEND_HOST="127.0.0.1"
FRONTEND_PORT="3000"
FRONTEND_URL="http://127.0.0.1:3000"

# --- Backoffice (TanStack Start / Vite) ---
BACKOFFICE_HOST="127.0.0.1"
BACKOFFICE_PORT="3002"
BACKOFFICE_URL="http://127.0.0.1:3002"

# Browser-exposed API base URL (must be prefixed with VITE_)
VITE_API_URL="http://127.0.0.1:3001"

# --- CORS ---
# Comma-separated origins allowed by the API (frontend + backoffice)
CORS_ORIGIN="http://127.0.0.1:3000,http://127.0.0.1:3002"

# --- Runtime ---
NODE_ENV="development"
