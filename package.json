{
  "name": "@dukerspace/starter",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dukerspace/starter.git"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "turbo run db:generate --filter=@starter/database",
    "db:validate": "turbo run db:validate --filter=@starter/database",
    "db:migrate": "turbo run db:migrate --filter=@starter/database",
    "postinstall": "bun run scripts/rename-project.ts --prompt",
    "rename": "bun run scripts/rename-project.ts"
  },
  "devDependencies": {
    "prettier": "^3.9.7",
    "turbo": "^2.10.13",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "prisma": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  }
}
