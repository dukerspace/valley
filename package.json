{
  "name": "valley",
  "version": "0.1.0",
  "description": "Scaffold a Bun + Turbo full-stack app (Hono, TanStack Start, Prisma)",
  "author": "dukerspace",
  "license": "MIT",
  "type": "module",
  "bin": {
    "valley": "./src/index.ts"
  },
  "files": [
    "src",
    "packages",
    ".agents",
    ".skills",
    ".cursor/rules",
    "templates",
    "templates/valley/.env.example",
    "templates/valley/.gitignore",
    "templates/valley/.editorconfig",
    "templates/valley/.prettierrc",
    "templates/valley/.prettierignore"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dukerspace/valley.git"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "valley": "bun src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "prettier": "^3.9.7",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  }
}
